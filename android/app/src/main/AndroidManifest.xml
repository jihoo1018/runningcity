<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
    ⚠️ 참고: Android 10 이상에서는 위치 권한이 3단계로 나뉩니다
    앱이 처음 실행될 때 다음 세 가지 중 선택할 수 있어요:
    "앱을 사용하는 동안만 허용"
    "한 번만 허용"
    "항상 허용"
    → ACCESS_BACKGROUND_LOCATION 은 “항상 허용”을 받아야 작동합니다.
    따라서 Android 10(API 29)+ 기기에서는 위치 추적이 제한될 수 있습니다.
    (앱이 완전히 백그라운드일 때 위치 수집이 필요하면, 설정에서 직접 권한을 변경하도록 안내해야 해요.)
    -->
    <!-- ✅ 위치 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" /> <!-- 고정밀 GPS 사용 (필수) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /><!-- Wi-Fi / 셀룰러 기반 위치 -->
    <!-- Android 10 이상에서 백그라운드 위치를 허용하려면 필요 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" /><!-- 앱이 백그라운드일 때도 위치 추적 -->
    <!-- ✅ 네트워크 및 포그라운드 서비스 권한 -->
    <uses-permission android:name="android.permission.INTERNET" /><!-- 서버로 데이터 전송 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" /><!-- 위치 추적을 위한 포그라운드 서비스 -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Runningcity"
        tools:targetApi="31">
        <!-- ✅ 위치 추적용 서비스 등록 -->
        <service
            android:name=".LocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" /> <!-- foregroundServiceType="location" : Android 10(API 29)+ 에서 필수 설정 -->

        <!-- ✅ 기본 Activity (앱 진입점) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Runningcity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>